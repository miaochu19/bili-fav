    "tools.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bilibili",
    "favorites",
    "obsidian"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
